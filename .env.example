# Grohe NEO Integration — environment variables
# Copy to .env and fill in values. .env is gitignored.
# Run: cp .env.example .env

# ─── Sitecore mode ────────────────────────────────────────────────────────────
# mock  — all Sitecore calls go to WireMock (default, safe for local dev + CI)
# qa    — calls real Sitecore QA environment (read-only assertions only)
# uat   — calls real Sitecore UAT environment
# prod  — calls real Sitecore PROD environment (read-only, use with caution)
SITECORE_MODE=mock

# Required when SITECORE_MODE=qa/uat/prod:
SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDGE_API_KEY=
SITECORE_CM_API_KEY=

# ─── Firestore emulator ───────────────────────────────────────────────────────
# Leave as-is for local dev. Change only if port 8080 is in use.
FIRESTORE_EMULATOR_HOST=localhost:8080

# ─── Service ports ────────────────────────────────────────────────────────────
# Leave as-is unless there is a local port conflict.
INDEXING_API_HOST=localhost:8082
NAVIGATION_API_HOST=localhost:8083
PRODUCTS_API_HOST=localhost:8084
SEARCH_API_HOST=localhost:8085
PROJECT_LISTS_API_HOST=localhost:8086
SHOPPING_CART_API_HOST=localhost:8087
USER_API_HOST=localhost:8088
PRICING_API_HOST=localhost:8089
ORDER_API_HOST=localhost:8090
FORMS_API_HOST=localhost:8092
REDIRECTIONS_API_HOST=localhost:8093
